.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

opencode.json

# generated/downloaded content -- directory structure is tracked via
# .gitkeep, contents are not
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/tokenized/*
!data/tokenized/.gitkeep
data/alignments/*
!data/alignments/.gitkeep
data/metadata/*
!data/metadata/.gitkeep
data/cache/*
!data/cache/.gitkeep

checkpoints/*/*
!checkpoints/*/.gitkeep

outputs/*/*
!outputs/*/.gitkeep


